# Open WebUI: address and token of an administrator account (Settings > Account > API keys, or a session token).
OWUI_URL=http://127.0.0.1:8080
OWUI_TOKEN=
# Image server as seen from Open WebUI (Kubernetes service), no trailing slash, no key.
COMFYUI_URL=http://comfyui.comfyui.svc.cluster.local:8188
# ComfyUI's interface in your browser (to drop the workflow and the photo: python setup_editing.py --comfyui).
COMFYUI_INTERFACE=http://comfyui.localhost:8080
# Editing model (file name in ComfyUI's models/diffusion_models/).
EDIT_MODEL=flux-2-klein-4b-fp8.safetensors
