# Open WebUI : adresse et jeton d'un compte administrateur (Réglages › Compte › Clés API, ou jeton de session).
OWUI_URL=http://127.0.0.1:8080
OWUI_JETON=
# Serveur d'images vu depuis Open WebUI (service Kubernetes), sans barre finale ni clé.
COMFYUI_URL=http://comfyui.comfyui.svc.cluster.local:8188
# Interface de ComfyUI dans votre navigateur (pour déposer le workflow et la photo : python activer_retouche.py --comfyui).
COMFYUI_INTERFACE=http://comfyui.localhost:8080
# Modèle de retouche (nom du fichier dans models/diffusion_models/ de ComfyUI).
MODELE_RETOUCHE=flux-2-klein-4b-fp8.safetensors
